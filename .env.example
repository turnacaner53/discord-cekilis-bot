# Yerel gelistirme icin AYRI bir Discord uygulamasi ac (orn. "cekilis-local-bot").
# Panel ile ayni token kullanilirsa ikisi ayni bot olur; hangisinin cevap verdigi anlasilmaz
# ve ayni anda calisirlarsa her komuta iki cevap gelir.
DISCORD_TOKEN=buraya_test_botunun_tokeni

# Opsiyonel, sadece yerelde: komutlar bu sunucuya aninda kaydolur (global kayit ~1 saat surer).
# Panelde BOS BIRAK -> global kayit, botun ekli oldugu her sunucuda gorunur.
GUILD_ID=
